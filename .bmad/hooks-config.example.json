{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Merge the hooks section into your project's .claude/settings.json to enable BMAD hooks (nested schema: matcher group > hooks[])",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.bmad/hooks/sprint-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.bmad/hooks/story-status.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.bmad/hooks/quality-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "_bmad_config": {
    "enforce_gates": true,
    "auto_route": false,
    "tdd_tracking": true
  }
}
