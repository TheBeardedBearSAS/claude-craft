{
  "$schema": "https://claude.ai/settings-schema.json",

  "spinnerVerbs": {
    "default": ["Thinking", "Processing", "Analyzing", "Working"],
    "Edit": ["Editing", "Modifying", "Updating"],
    "Write": ["Writing", "Creating", "Generating"],
    "Bash": ["Running", "Executing", "Processing"],
    "Read": ["Reading", "Loading", "Scanning"],
    "Task": ["Delegating", "Coordinating", "Dispatching"]
  },

  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(composer:*)",
      "Bash(php bin/console:*)",
      "Bash(php artisan:*)",
      "Bash(dotnet:*)",
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(flutter:*)",
      "Bash(ng:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(curl | sh:*)",
      "Bash(wget | sh:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*credentials*)"
    ]
  },

  "model": "claude-sonnet-4-20250514",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous-commands.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-lint.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/quality-gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
