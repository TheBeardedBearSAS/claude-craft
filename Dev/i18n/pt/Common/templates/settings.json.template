{
  "$schema": "https://claude.ai/settings-schema.json",

  "spinnerVerbs": {
    "default": ["Pensando", "Processando", "Analisando", "Trabalhando"],
    "Edit": ["Editando", "Modificando", "Atualizando"],
    "Write": ["Escrevendo", "Criando", "Gerando"],
    "Bash": ["Executando", "Rodando", "Processando"],
    "Read": ["Lendo", "Carregando", "Escaneando"],
    "Task": ["Delegando", "Coordenando", "Despachando"]
  },

  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(npm run:*)",
      "Bash(composer:*)",
      "Bash(php bin/console:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  },

  "model": "claude-sonnet-4-20250514",

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-lint.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/quality-gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
