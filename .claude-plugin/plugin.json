    },
    "notable": [
      "@tdd-coach",
      "@api-designer",
      "@security-auditor",
      "@devops-engineer",
      "@ralph-conductor",
      "@uiux-orchestrator"
    ]
  },
  "commands": {
    "count": 125,
    "namespaces": 15,
    "list": [
      "common",
      "workflow",
      "team",
      "qa",
      "uiux",
      "symfony",
      "react",
      "flutter",
      "python",
      "angular",
      "vuejs",
      "laravel",
      "reactnative",
      "csharp",
      "php"
    ]
  },
  "skills": {
    "count": 48,
    "categories": [
      "architecture",
      "testing",
      "security",
      "workflow",
      "stack-specific"
    ]
  },
  "stacks": {
    "count": 19,
    "application": [
      "symfony",
      "react",
      "flutter",
      "python",
      "php",
      "reactnative",
      "angular",
      "csharp",
      "laravel",
      "vuejs",
      "paperclip"
    ],
