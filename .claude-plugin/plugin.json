      "recommended": "2.1.159",
      "tested": "2.1.159"
    },
    "node": ">=20.0.0"
  },
  "capabilities": {
    "skills": true,
    "agents": true,
    "hooks": true,
    "mcp": true,
    "kanban": true,
    "qaRecette": true
  },
  "agents": {
    "count": 70,
    "categories": {
      "common": 20,
      "tech-reviewers": 11,
      "infrastructure": 39,
