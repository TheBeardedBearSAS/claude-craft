      "docker",
      "coolify",
      "kubernetes",
      "opentofu",
      "ansible",
      "hcloud",
      "pgbouncer",
      "frankenphp"
    ]
  },
  "languages": ["en", "fr", "es", "de", "pt"],
  "categories": [
    "development",
    "productivity",
    "quality",
    "team-collaboration"
  ],
  "installation": {
    "npm": "@the-bearded-bear/claude-craft",
    "command": "npx @the-bearded-bear/claude-craft install",
    "docs": "https://thebeardedcto.com/claude-craft/getting-started"
  },
  "features": {
    "bmad-v6": {
      "description": "Complete sprint workflow (Analyze → Plan → Design → Implement → QA Recette)",
      "tracks": ["quick-flow", "standard", "enterprise"],
      "qualityGates": {
        "prd": ">=80%",
        "techSpec": ">=90%",
        "invest": "6/6",
        "sprintReady": "100%",
        "storyDod": "100%",
        "specAlignment": ">=85%"
      }
    },
    "qa-recette": {
      "description": "Browser-based acceptance testing via Chrome with Golden Rule regression enforcement",
      "goldenRule": "A fixed bug should NEVER reappear",
      "prerequisite": "Chrome extension v1.0.36+"
    },
    "kanban-local": {
      "description": "Local Kanban board without SaaS dependency (Svelte + Hono + chokidar)",
      "stack": ["svelte", "hono", "chokidar"]
    },
    "ralph-wiggum": {
      "description": "Continuous AI loop with adaptive circuit breaker and DoD validators",
      "command": "/common:ralph-run",
      "validators": ["command", "output_contains", "file_changed", "hook", "human"]
    },
    "i18n": {
      "description": "Full internationalization across 5 languages",
      "languages": ["en", "fr", "es", "de", "pt"]
    },
    "lsp-plugins": {
      "description": "Code intelligence via LSP plugins (PHP, TypeScript, Python, Dart, C#)",
      "available": ["php-lsp", "typescript-lsp", "pyright-lsp", "dart-analyzer", "csharp-lsp"]
    }
  },
  "marketplace": {
    "submitted": "2026-05-06",
    "tier": "verified-publisher",
    "categories": ["development-framework", "team-tooling", "quality-assurance"]
  },
  "security": {
    "minimumForProduction": "2.1.97",
    "cvePatched": ["CVE-2025-59536", "CVE-2026-21852"],
    "notes": "Run 2.1.97+ when using MCP servers or Bash tool in automated workflows"
  }
}
