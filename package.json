{
  "name": "@the-bearded-bear/claude-craft",
  "version": "8.20.0",
  "description": "A comprehensive framework for AI-assisted development with Claude Code. Install standardized rules, agents, and commands for your projects.",
  "type": "module",
  "main": "cli/index.js",
  "bin": {
    "claude-craft": "./cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:content": "vitest run tests/content/",
    "test:watch": "vitest",
    "lint": "eslint cli/ scripts/",
    "lint:fix": "eslint cli/ scripts/ --fix",
    "lint:shell": "find Dev/ Infra/ Project/ Tools/ scripts/ .bmad/ website/scripts/ -name '*.sh' -type f | xargs shellcheck --severity=warning",
    "lint:i18n": "bash scripts/verify-i18n-parity.sh",
    "lint:includes": "node scripts/verify-claude-includes.mjs",
    "lint:versions": "node scripts/verify-versions.mjs",
    "docs:generate": "node scripts/generate-references.mjs",
    "docs:check": "node scripts/generate-references.mjs --check",
    "format:check": "prettier --check cli/",
    "format": "prettier --write cli/",
    "kanban:build": "vite build --config cli/kanban/client/vite.config.js",
    "kanban:dev": "vite --config cli/kanban/client/vite.config.js",
    "vale:check": "vale docs/ .claude/CLAUDE.md README.md CHANGELOG.md",
    "vale:sync": "vale sync",
    "commitlint": "commitlint --edit",
    "prepublishOnly": "node -e \"import{readFileSync}from'node:fs';const p=JSON.parse(readFileSync('./package.json','utf8'));if(!/^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$/i.test(p.version)){console.error('Invalid version format');process.exit(1)}\"",
    "metrics:adoption": "node scripts/track-adoption-metrics.mjs",
    "mutation": "stryker run",
    "mutation:ci": "stryker run --reporters progress,json",
    "test:e2e:tools": "cd tests/e2e/tools && docker compose -f docker-compose.test.yml up --abort-on-container-exit --exit-code-from e2e-runner",
    "community:awesome": "node scripts/awesome-claude-code-submit.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "development",
    "rules",
    "agents",
    "commands",
    "workflow",
    "symfony",
    "flutter",
    "react",
    "python"
  ],
  "author": "TheBeardedCTO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBeardedBearSAS/claude-craft.git"
  },
  "bugs": {
    "url": "https://github.com/TheBeardedBearSAS/claude-craft/issues"
  },
  "homepage": "https://github.com/TheBeardedBearSAS/claude-craft#readme",
  "engines": {
    "node": ">=22.0.0",
    "os": [
      "linux",
      "darwin"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "^10.0.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "cytoscape": "^3.33.2",
    "cytoscape-dagre": "^4.0.0",
    "dompurify": "^3.4.11",
    "eslint": "10.6.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.8.0",
    "prettier": "3.9.5",
    "svelte": "^5.55.4",
    "uplot": "^1.6.32",
    "vite": "^8.0.14",
    "vitest": "4.1.10"
  },
  "files": [
    "bundles/",
    "cli/",
    "Dev/",
    "Infra/",
    "Project/",
    "Tools/"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "chokidar": "^5.0.0",
    "hono": "^4.12.14",
    "js-yaml": "^5.2.0",
    "marked": "^18.0.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
